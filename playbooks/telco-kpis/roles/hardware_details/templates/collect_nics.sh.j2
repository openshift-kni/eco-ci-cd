#!/usr/bin/env python3
import subprocess
import sys
import json

try:
    out = subprocess.check_output(
        ['lspci', '-D', '-vmm'],
        stderr=subprocess.DEVNULL,
        timeout=15
    ).decode()
except Exception:
    print('[]')
    sys.exit(0)

# Ensure trailing blank line so last device is processed
out += '\n'

aggregated = {}
current = {}
for line in out.splitlines():
    line = line.strip()
    if not line:
        cls = current.get('Class', '')
        device = current.get('Device', '')
        if 'Ethernet' in cls:
            skip_terms = ('Virtual Function', 'Adaptive Virtual', ' VF ')
            if not any(t in device for t in skip_terms):
                vendor = current.get('Vendor', 'Unknown').split()[0]
                key = (vendor, device)
                aggregated[key] = aggregated.get(key, 0) + 1
        current = {}
        continue
    if ':' in line:
        k, _, v = line.partition(':')
        current[k.strip()] = v.strip()

result = []
for (vendor, model), count in sorted(aggregated.items()):
    result.append({'count': count, 'vendor': vendor, 'model': model})

print(json.dumps(result))
