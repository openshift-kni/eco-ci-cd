---
apiVersion: v1
kind: Secret
metadata:
  name: oauth-client-secrets
  namespace: {{ oran_o2ims_deploy_namespace }}
type: Opaque
stringData:
  client-id: o2ims-client
  # Derived from the o2ims-client entry in the realm export (see tasks/main.yaml).
  client-secret: {{ oran_o2ims_client_secret }}

---
