{# Renders only for a node that has a console password set. #}
{% if console_password | default('') | trim | length > 0 %}
apiVersion: machineconfiguration.openshift.io/v1
kind: MachineConfig
metadata:
  name: 99-master-console-password
  labels:
    machineconfiguration.openshift.io/role: master
spec:
  config:
    ignition:
      version: 3.4.0
    passwd:
      users:
        # SHA-512 crypt hash of console_password, for console login during lab debugging.
        # Rounds are pinned to the classic crypt default to keep the '$6$<salt>$<hash>'
        # form; the salt is random unless console_password_salt pins it.
        - name: core
          passwordHash: "{{ console_password | trim | password_hash('sha512', console_password_salt | trim, rounds=5000) }}"
{% endif %}
