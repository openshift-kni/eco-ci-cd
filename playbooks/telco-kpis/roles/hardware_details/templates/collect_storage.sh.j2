#!/usr/bin/env python3
import json
import subprocess
import sys

try:
    out = subprocess.check_output(
        ['lsblk', '-J', '-o', 'NAME,TYPE,SIZE,MODEL'],
        stderr=subprocess.DEVNULL,
        timeout=15
    ).decode()
    data = json.loads(out)
except Exception:
    print('[]')
    sys.exit(0)

aggregated = {}
for dev in data.get('blockdevices', []):
    if dev.get('type') != 'disk':
        continue
    model = (dev.get('model') or 'Unknown').strip()
    size = (dev.get('size') or '').strip()
    key = (model, size)
    aggregated[key] = aggregated.get(key, 0) + 1

result = []
for (model, size), count in sorted(aggregated.items()):
    result.append({'count': count, 'model': model, 'size': size})

print(json.dumps(result))
