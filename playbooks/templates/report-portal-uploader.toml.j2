# Generated by playbooks/upload-report.yaml for report-portal-uploader (`rpu upload`).
[report_portal]
hostname = {{ report_portal_hostname | to_json }}
project = {{ report_portal_project | to_json }}

[launch]
name = {{ report_portal_launch_name | to_json }}
description = {{ report_portal_launch_description | to_json }}

[launch.attributes]
{% for key, value in report_portal_attributes.items() %}
{{ key | to_json }} = {{ value | to_json }}
{% endfor %}

[processing]
property_filter = ["polarion-.*"]
exclude_patterns = []

[output]
launch_url_file = {{ report_portal_launch_url_file | to_json }}

[[sources]]
path = {{ report_portal_reports_glob | to_json }}
